            var(--color-secondary-1)
        );
    }

    .structure {
        position: relative;
        z-index: 2;
        transform: scale(1.3);
        top: 2.5rem;
    }

    .path {
        stroke: var(--color-primary-3);
        stroke-width: 4px;
    }

    .path-node-ring {
        fill: color-mix(in srgb, var(--color-secondary-1), white 20%);
    }

    .path-node-center {
        fill: var(--color-primary-3);
    }

    .dot {
        transform-origin: center;
    }
</style>
