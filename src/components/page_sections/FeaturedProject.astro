---
import ButtonLink from "@components/ButtonLink.astro";
import type { CollectionEntry } from "astro:content";
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import { WEBSITE_TYPES } from "@utils/websiteTypes";
import bgImage from "@assets/shape-pattern-1.svg";

type Props = {
    project: CollectionEntry<"projects">;
};

const { project } = Astro.props;

const col1: string[] = [];
const col2: string[] = [];
const midpoint = Math.round(project.data.features.length / 2);

for (let i = 0; i < project.data.features.length; i++) {
    const item = project.data.features[i];
    if (i <= midpoint - 1) {
        col1.push(item);
    } else {
        col2.push(item);
    }
}
---

<article class="featured | dark" id="featured-project">
    <div class="grid-9 | content-wrapper">
        <Image
            alt={project.data.featuredImage.alt}
            class="featured-img rounded-corners"
            format="webp"
            loading="lazy"
            src={project.data.featuredImage.src}
            width={1200}
        />
        <div class="text | flow">
            <header>
                <div class="eyebrow | small-title text-gradient">
                    {WEBSITE_TYPES[project.data.type]}
                </div>
                <h2>{project.data.client}</h2>
            </header>
            <!-- <p>{project.data.summary}</p> -->
            <div class="icon-list">
                <div class="col">
                    {
                        col1.map((item) => (
                            <p class="row">
                                <Icon name="fa-circle-check" />
                                <span>{item}</span>
                            </p>
                        ))
                    }
                </div>
                <div class="col">
                    {
                        col2.map((item) => (
                            <p class="row">
                                <Icon name="fa-circle-check" />
                                <span>{item}</span>
                            </p>
                        ))
                    }
                </div>
            </div>
            <ButtonLink href={`/work/${project?.id}`}>
                <span>View Case Study</span>
                <Icon name="fa-arrow-right" />
            </ButtonLink>
        </div>
    </div>
    <Image
        alt=""
        class="bg-image"
        format="svg"
        loading="lazy"
        src={bgImage}
        width={900}
    />
</article>

<style>
    article {
        position: relative;
        padding-block: calc(var(--section-spacer) * 1.5);
        background: var(--color-darker-gradient);
        overflow: hidden;

        &::after {
            content: "";
            position: absolute;
            height: 4px;
            bottom: 0;
            width: 100%;
            background: linear-gradient(
                to right,
                var(--color-secondary-5),
                var(--color-primary-4)
            );
        }
    }

    .grid-9 {
        position: relative;
        z-index: 2;
        align-items: center;
        gap: var(--space-2xl);
    }

    .text {
        grid-column: 5/10;

        &.flow {
            --flow-space: var(--space-m);
        }
    }

    .small-title.eyebrow {
        margin-block-end: var(--space-2xs);
    }

    .icon-list {
        margin-block-start: var(--space-2xs);
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: var(--space-s);
    }

    :global(.featured .icon-list svg) {
        position: relative;
        float: left;
        margin-right: 0.5rem;
        top: 3px;
        color: var(--color-primary-4);
        width: 1em;
        height: 1em;
    }

    .col > * + * {
        margin-block-start: 0.75rem;
    }

    .featured-img {
        grid-column: 1 / span 4;
    }

    .bg-image {
        position: absolute;
        left: -5%;
        top: 0;
        width: auto;
        height: 100%;
        opacity: 0.25;
        mix-blend-mode: screen;
        transform: scale(1.5);
    }

    @container contentWrapper (max-width: 999px) {
        .text {
            grid-column: span 9;
        }

        .featured-img {
            grid-column: span 9;
        }
    }

    @media (max-width: 640px) {
        article {
            padding-block: var(--space-3xl);
        }

        .grid-9 {
            row-gap: var(--space-l);
            column-gap: 0;
        }
    }
</style>
