---
import ButtonLink from "@components/ButtonLink.astro";
import Card from "@components/Card.astro";
import type { CollectionEntry } from "astro:content";
import FrontendDevIllustration from "@components/page_sections/FrontendDevIllustration.astro";
import Icon from "@components/Icon.astro";
import type { IconName } from "@components/Icon.astro";
import UXIllustration from "@components/illustrations/UXIllustration.astro";
import WebDesignIllustration from "@components/illustrations/WebDesignIllustration.astro";
import { getCollection } from "astro:content";

// type Props = {
//     entries: CollectionEntry<"services">[];
// };

// const { entries } = Astro.props;

const highlights = await getCollection("highlights");
---

<div class="grid-6 feature-span">
    {
        highlights
            .sort((a, b) => (a.data.order > b.data.order ? 1 : -1))
            .map((entry, index) => {
                let Illustration = undefined;
                switch (entry.data.illustration) {
                    case "fluid-design":
                        Illustration = WebDesignIllustration;
                        break;
                    case "ux":
                        Illustration = UXIllustration;
                        break;
                }

                return (
                    <Card id={entry.id}>
                        {entry.data.icon && (
                            <div class="icon-wrapper gradient">
                                <Icon
                                    color="currentColor"
                                    name={entry.data.icon as IconName}
                                    size="1em"
                                />
                            </div>
                        )}
                        <h3 class="text-step-1">{entry.data.title}</h3>
                        <p>{entry.data.summary}</p>
                        {entry.data.link && (
                            <footer>
                                <a
                                    class="cluster"
                                    href={entry.data.link.href}
                                    style="--cluster-space: 0.5rem"
                                >
                                    <strong>{entry.data.link.text}</strong>
                                    <Icon name="chevron-right" size="1em" />
                                </a>
                            </footer>
                        )}
                        {Illustration && <Illustration slot="after-content" />}
                    </Card>
                );
            })
    }
