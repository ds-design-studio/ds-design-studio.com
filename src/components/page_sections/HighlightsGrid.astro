<script>
    // @ts-ignore
    import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";
    import { Flip } from "gsap/Flip";
    import { gsap } from "gsap";

    document.addEventListener("astro:page-load", () => {
        gsap.registerPlugin(Flip);
        gsap.registerPlugin(DrawSVGPlugin);

        /* USER EXPERIENCE */
        const uxIllustration = document.querySelector(
            "#optimal-user-experience .motion-illustration",
        );

        uxIllustration?.addEventListener("mouseenter", () => {
            const tl = gsap.timeline();
            const dot1 = uxIllustration?.querySelector(".dot.level-1");
            const dot2 = uxIllustration?.querySelectorAll(".dot.level-2");
            const dot3 = uxIllustration?.querySelectorAll(".dot.level-3");

            tl.from(".motion-illustration .structure .path.main", {
                duration: 1.5,
                drawSVG: "50% 50%",
            });
            tl.from(
                ".motion-illustration .structure .path.right",
                {
                    duration: 1,
                    drawSVG: 0,
                },
                0.4,
            );
            tl.from(
                ".motion-illustration .structure .path.left",
                {
                    duration: 1,
                    drawSVG: "100% 100%",
                },
                0.4,
            );
            tl.from(
                dot1,
                {
                    opacity: 0,
                    duration: 0.4,
                    scaleY: 1.1,
                },
                0,
            );

            dot2.forEach((dot) =>
                tl.from(
                    dot,
                    {
                        opacity: 0,
                        duration: 0.4,
                        scaleY: 1.1,
                    },
                    0.3,
                ),
            );

            dot3.forEach((dot) =>
                tl.from(dot, { opacity: 0, duration: 0.4, scaleY: 1.1 }, 0.6),
            );
        });

        /* WEB DESIGN */
        const webDesignIllustration = document.querySelector(
            "#adaptable-design .motion-illustration",
        );
        const row = webDesignIllustration?.querySelector(".row.animate");
        const screen = webDesignIllustration?.querySelector(".screen");
        // const panes = webDesignIllustration?.querySelectorAll(".pane");

        webDesignIllustration?.addEventListener("mouseenter", () => {
            const state = Flip.getState(".pane, .screen");
            // console.log(state);

            screen?.classList.toggle("slim");
            row?.classList.toggle("reorder");

            Flip.from(state, {
                absolute: true,
                duration: 0.4,
                ease: "power1.out",
            });
        });

        webDesignIllustration?.addEventListener("mouseleave", () => {
            const state = Flip.getState(".pane, .screen");
            // console.log(state);

            screen?.classList.toggle("slim");
            row?.classList.toggle("reorder");

            Flip.from(state, {
                absolute: true,
                duration: 0.3,
                ease: "power1.out",
            });
        });
    });
</script>
