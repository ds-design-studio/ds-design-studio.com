---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
// import Testimonial from "@components/Testimonial.astro";
import featuredImage from "@assets/ds-mexico.jpg";
import { getCollection } from "astro:content";
import headshot from "@assets/ds-pro-avatar.jpg";
import shapes1 from "@assets/shapes-1.png";

const testimonials = await getCollection("testimonials");
---

<div class="content-wrapper" id="testimonials">
    <h2 class="sr-only">Testimonials</h2>
    <div class="grid-9">
        <div class="image-wrapper">
            <Image
                alt=""
                class="featured-image"
                format="webp"
                src={featuredImage}
                width={800}
            />
        </div>
        <!-- TODO: Get new testimonials -->
        <!-- {
      testimonials.slice(0, 3).map((testimonial) => (
        <div class="testimonial-wrapper">
          <Testimonial content={testimonial} />
        </div>
      ))
    } -->
        <article class="about">
            <div class="text | flow">
                <Image
                    alt=""
                    class="shapes"
                    format="webp"
                    src={shapes1}
                    width={600}
                />
                <header>
                    <h3>About Daniel Saunders</h3>
                    <p class="small-title text-gradient">
                        Principal Designer/Developer
                    </p>
                </header>
                <p>
                    I’m a freelance web designer and developer with over a
                    decade of experience creating visually captivating,
                    successful websites for individuals, teams, non-profits,
                    faith-based organizations, and businesses.
                </p>
                <a
                    class="cluster"
                    href="/about"
                    style="--cluster-space: 0.5rem"
                >
                    <strong>About Me</strong>
                    <Icon name="fa-chevron-right" size="0.875em" />
                </a>
            </div>
        </article>
    </div>
</div>

<style>
    .content-wrapper {
        margin-block: var(--section-spacer);
    }

    .grid-9 {
        row-gap: var(--space-xl);
        /* align-items: center; */

        /* & > :first-child {
            grid-column: span 5;
        }

        & > :nth-child(2) {
            grid-column: 7 / span 3;
        }

        & > :nth-child(3) {
            grid-column: 7 / span 3;
            grid-row: 2/2;
            align-self: center;
        }

        & > :last-child {
            order: 9;
            grid-column: 3 / span 5;
        } */
    }

    .featured-image {
        mix-blend-mode: hard-light;
    }

    .image-wrapper {
        grid-column: 2 / 5;
        border-radius: var(--rounded-corners);
        overflow: hidden;
        background: linear-gradient(
            to bottom right,
            var(--color-primary-4),
            var(--color-secondary-5)
        );
    }

    .shapes {
        max-width: 6rem;
    }

    .about {
        border-radius: var(--rounded-corners);
        padding: var(--space-l);
        background: linear-gradient(to right, white, var(--color-neutral-1));
        box-shadow: var(--shadow-light);
        border: 1px solid var(--color-neutral-2-fade);
        grid-column: span 4;

        & header {
            margin-block-start: var(--space-2xs);

            &.cluster {
                --cluster-space: 2rem;
            }

            & .small-title {
                margin-block-start: var(--space-2xs);
            }
        }
    }

    .headshot {
        border-radius: 999px;
        background: linear-gradient(
            to bottom right,
            var(--color-secondary-5),
            var(--color-primary-4)
        );

        & img {
            width: 5rem;
            height: 5rem;
            margin: 2px;
            aspect-ratio: 1;
            object-fit: cover;
            border-radius: 999px;
            filter: grayscale(1);
            mix-blend-mode: overlay;
            opacity: 0.85;
        }
    }

    @container contentWrapper (max-width: 768px) {
        .grid-9 {
            & > :last-child {
                grid-column: 1 / span all;
            }
        }
    }
</style>
