---
interface Props {
    style?: "inline" | "box";
}

const availableDate = "April 2026";
const status: "ready" | "booked" = "ready";

const { style = "inline" } = Astro.props;
---

<div class:list={["availability", style]} data-status={status}>
    <p>Available from {availableDate}</p>
</div>

<style>
    .availability {
        --status-ready: greenyellow;
        --status-booked: var(--color-primary-4);
        position: relative;
        font-weight: 700;

        &[data-status="ready"] {
            --status: var(--status-ready);
        }

        &[data-status="booked"] {
            --status: var(--status-booked);
        }

        &:hover::before {
            transform: scale(1.2);
        }

        &::before {
            content: "";
            position: absolute;
            inset: var(--dot-position, 6px 0 0 -1rem);
            border-radius: 999px;
            background-color: var(--status);
            height: var(--dot-size, 0.5rem);
            width: var(--dot-size, 0.5rem);
            transition: transform 0.3s;
        }
    }

    .inline {
        font-size: var(--step--1);
    }

    .box {
        --dot-size: 0.75rem;
        --dot-position: 13px 0 0 0.65rem;
        padding-block: 0.35rem;
        padding-inline: 2rem 1.5rem;
        background-color: color-mix(in srgb, var(--status), transparent 75%);
        width: fit-content;
        border-radius: 0.25rem;
        border: 1px solid var(--status);
    }
</style>
