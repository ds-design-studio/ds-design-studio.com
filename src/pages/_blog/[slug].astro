---
import { getCollection, getEntry, render } from "astro:content";
import Breadcrumb from "@components/Breadcrumb.astro";
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import { format } from "@formkit/tempo";
import headshot from "@assets/ds-pro-avatar.jpg";

export async function getStaticPaths() {
    const posts = await getCollection("posts");

    return posts.map((post) => ({
        params: {
            slug: post.id,
        },
        props: { post },
    }));
}

const { post } = Astro.props;

const { Content, headings } = await render(post);

type TOC = {
    slug: string;
    text: string;
    children?: {
        slug: string;
        text: string;
    }[];
};
const toc: TOC[] = [];
for (let i = 0; i < headings.length; i++) {
    const item = headings[i];
    if (item.depth === 2) {
        toc.push({ slug: item.slug, text: item.text, children: [] });
    }

    if (item.depth === 3) {
        const prev = toc[toc.length - 1];
        prev.children?.push({ slug: item.slug, text: item.text });
    }
}

const category = await getEntry("categories", post.data.category.id);

const authorAbout =
    "<a href='/about'>Daniel Saunders</a> is the principal designer and developer at DS Design, a Los-Angeles based web studio focusing on building hand-crafted, resilient websites.";

// TODO: add 'updated at' property to date
---

<Layout headerTheme="dark">
    <main slot="content">
        <article>
            <div class="hero | dark">
                <div class="content-wrapper background-lines">
                    <header class="flow">
                        <div class="cluster">
                            <Breadcrumb
                                current={category?.data.name}
                                parents={[{ name: "Blog", slug: "blog" }]}
                            />
                        </div>
                        <h1>{post.data.title}</h1>
                        <time
                            datetime={format({
                                date: post.data.published_on,
                                format: "YYYY-MM-DD",
                                tz: "UTC",
                            })}
                            >{
                                format({
                                    date: post.data.published_on,
                                    format: "long",
                                    tz: "UTC",
                                })
                            }</time
                        >
                        <div class="cluster">
                            <div class="headshot">
                                <Image
                                    alt="My headshot: a man with short hair, glasses, and a friendly smile."
                                    format="webp"
                                    loading="lazy"
                                    src={headshot}
                                    width={600}
                                />
                            </div>
                            <a href="/about">Daniel Saunders</a>
                        </div>
                    </header>
                </div>
                <div class="rounded-block">
                    <div class="content-wrapper"></div>
                    <div></div>
                </div>
            </div>
            <div class="content-wrapper">
                <div class="rich-content">
                    <details class="toc">
                        <summary>
                            <span>Table of Contents</span>
                            <Icon name="chevron-down" />
                        </summary>
                        <ul class="headings">
                            {
                                toc.map((heading) => (
                                    <li>
                                        <a href={`#${heading.slug}`}>
                                            {heading.text}
                                        </a>
                                        {heading.children &&
                                            heading.children.length > 0 && (
                                                <ul class="subheadings">
                                                    {heading.children.map(
                                                        (subHeading) => (
                                                            <li>
                                                                <a
                                                                    href={`#${subHeading.slug}`}
                                                                >
                                                                    {
                                                                        subHeading.text
                                                                    }
                                                                </a>
                                                            </li>
                                                        ),
                                                    )}
                                                </ul>
                                            )}
                                    </li>
                                ))
                            }
                        </ul>
                    </details>
                    <Content />
                    <div class="about">
                        <p><strong>About the author</strong></p>
                        <p set:html={authorAbout} />
                    </div>
                </div>
            </div>
        </article>
    </main>
</Layout>

<style>
    /* header {
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;
    } */

    .hero {
        position: relative;
        padding-block-start: 10rem;
        padding-block-end: 8rem;
        background: var(--color-dark-gradient);
        overflow: hidden;

        & .flow {
            --flow-space: var(--space-m);
        }

        & header {
            max-width: 50rem;
            margin-inline: auto;
            text-align: center;
        }

        & .cluster {
            --cluster-justify: center;
        }
    }

    .headshot {
        border-radius: 999px;
        background: linear-gradient(
            to bottom right,
            var(--color-secondary-5),
            var(--color-primary-4)
        );

        & img {
            width: 3.75rem;
            height: 3.75rem;
            margin: 1.5px;
            aspect-ratio: 1;
            object-fit: cover;
            border-radius: 999px;
            filter: grayscale(1);
            mix-blend-mode: overlay;
            opacity: 0.85;
        }
    }

    /* .cluster:has(.headshot) {
        --cluster-justify: center;
    } */

    .toc {
        padding-block-start: calc(var(--space-s) + 6px);
        padding-block-end: calc(var(--space-s) + 3px);
        padding-inline: var(--space-m);
        border-radius: var(--rounded-corners);
        border: 1px solid color-mix(in hsl, var(--color-neutral-2), white 45%);
        box-shadow: var(--shadow-light);

        &[open] {
            & summary {
                color: var(--color-primary-4);
            }
        }

        & summary {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            font-family: var(--font-heading);
            font-weight: var(--font-heading-weight);
            line-height: 1.1;
            cursor: pointer;
            transition: color 0.2s;

            &:hover {
                color: var(--color-primary-4);
            }
        }
    }

    .headings {
        margin-block: var(--space-s);
        padding-inline-start: 1.125rem;
        font-size: var(--step-0);
    }

    .subheadings {
        margin-block-start: 0.25rem;
        padding-inline-start: 1.125rem;
    }

    :is(.headings, .subheadings) * + * {
        margin-block-start: 0.25rem;
    }

    .rich-content {
        font-size: var(--step-0_5);
        max-width: 46rem;
        padding-block-end: var(--section-spacer);
    }

    .about {
        font-size: var(--step--1);
        border-block-start: 1px solid
            color-mix(in hsl, var(--color-neutral-2), white 45%);
        padding-block-start: var(--space-l);
    }
</style>
