---
import CTA from "@components/page_sections/CTA.astro";
import { Image } from "astro:assets";
import InnerHero from "@components/page_sections/InnerHero.astro";
import Layout from "@layouts/Layout.astro";
import Team from "@components/page_sections/Team.astro";
import calloutBgImage from "@assets/shape-pattern-1.svg";
import { getCollection } from "astro:content";
import site from "@data/site.json";

const testimonials = await getCollection("testimonials");

const title = "About";
const capabilities = [
    "HTML",
    "CSS",
    "JavaScript/TypeScript",
    "PHP",
    "SEO",
    "UI/UX",
    "Frontend Frameworks",
    "Accessibility",
    "Content Management Systems (CMS)",
    "Virtual Private Servers (VPS)",
    "Domains/DNS",
    "Typography",
    "Graphic Design",
];

const ogParams = new URLSearchParams([
    ["title", "About Daniel Saunders"],
    [
        "subtitle",
        "Freelance web designer and developer with over a decade of experience",
    ],
]);

// TODO: add my new values

const expertiseTitle = "Areas of Expertise";
// const expertiseText = `In an era of fractured specializations, I wear the badge of “web generalist” with pride. I’m comfortable on all sides of the technological and creative spectrums, able to move seamlessly between content schemas, typographic pairings, and software libraries. One of the reasons why I love working in web development is that there is always something new to learn or an interesting problem to solve. I bring that <strong>passion for discovery</strong> to all my projects.`;
const expertiseText = `In an era of fractured specializations, I wear the badge of “web generalist” with pride. I’m comfortable on all sides of the technological and creative spectrums, and learning new things is one of the main reasons I love this work! I bring that <strong>passion for discovery</strong> to all my projects.`;
---

<Layout
    headerTheme="dark"
    meta={{
        seo: {
            title: title,
            description: site.about,
        },
        openGraph: {
            title: "About Daniel Saunders",
        },
    }}
>
    <main slot="content">
        <InnerHero title={title} />
        <div class="content-offset">
            <div class="section-bg-gradient">
                <div class="content-wrapper">
                    <Team testimonials={testimonials.slice(0, 2)} />
                </div>
            </div>
        </div>
        <div class="content-wrapper">
            <article class="callout | dark">
                <div class="grid-6 feature-span">
                    <header class="flow">
                        <h2 class="text-gradient">{expertiseTitle}</h2>
                        <p set:html={expertiseText} />
                    </header>
                    <div class="capabilities | cluster">
                        {capabilities.map((item) => <p>{item}</p>)}
                    </div>
                </div>
                <Image
                    alt=""
                    class="bg-image"
                    format="svg"
                    loading="lazy"
                    src={calloutBgImage}
                    width={600}
                />
            </article>
        </div>
        <CTA />
    </main>
</Layout>

<style>
    .section-bg-gradient {
        padding-block-end: 8rem;
    }

    .rich-content {
        margin-inline: 0;
    }

    :global(.about-stats .stats) {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / span all;
    }

    :global(.about-stats .stats > *) {
        grid-column: span 2;
    }

    .callout {
        top: -7rem;

        & h3 {
            font-size: var(--step-1);
        }

        & .grid-6 {
            gap: var(--space-2xl);
            margin-block: 0;
            align-items: center;
        }
    }

    .capabilities {
        gap: 1rem;
        /* margin-block-start: var(--space-m); */

        & p {
            padding: 0.6rem 0.75rem 0.45rem;
            background-color: var(--color-neutral-9);
            border: 1px solid var(--color-neutral-8);
            border-radius: var(--rounded-corners-small);
            line-height: 1.05;
            transition: background-color 0.2s ease;

            &:hover {
                background-color: var(--color-neutral-10);
            }
        }
    }

    @media (max-width: 480px) {
        .callout {
            padding: var(--space-l);
        }
    }
</style>
