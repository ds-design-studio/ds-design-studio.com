---
import { getCollection, getEntry } from "astro:content";
import ButtonLink from "@components/ButtonLink.astro";
import CTA from "@components/page_sections/CTA.astro";
import FeaturedProject from "@components/page_sections/FeaturedProject.astro";
import HighlightsGrid from "@components/page_sections/HighlightsGrid.astro";
import HomeApproach from "@components/page_sections/HomeApproach.astro";
import HomeHero from "@components/page_sections/HomeHero.astro";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import SectionHeader from "@components/SectionHeader.astro";
import Testimonials from "@components/page_sections/HomeTestimonials.astro";

// const services = await getCollection("services");
const featuredProject = await getEntry("projects", "sepsf");

import shapes1 from "@assets/shapes-1.png";

const eyebrow = "Why Work with Me?";
const heading = "Elevate your online presence with a strategic partner";
const text =
    "I help individuals and organizations connect with their communities by building websites that are <strong>attractive</strong>, <strong>informative</strong>, and <strong>user-friendly</strong>. My experience in <strong>both web design and development</strong> gives me a unique ability to deliver future-proofed solutions that unite form and function.";
---

<Layout>
    <main slot="content">
        <HomeHero />
        <div class="content-offset">
            <div class="section-bg-gradient">
                <article class="content-wrapper" id="services">
                    <SectionHeader align="left">
                        <Fragment slot="text">
                            <div class="eyebrow | small-title text-gradient">
                                {eyebrow}
                            </div>
                            <h2 class="text-step-4">{heading}</h2>
                            <p set:html={text} />
                        </Fragment>
                        <Image
                            alt=""
                            format="webp"
                            loading="eager"
                            slot="image"
                            src={shapes1}
                            width={600}
                        />
                    </SectionHeader>
                    <HighlightsGrid />
                    <div class="cluster cta-links">
                        <ButtonLink href="/services">View Services</ButtonLink>
                        <ButtonLink href="/process" theme="ghostPrimary"
                            >My Process</ButtonLink
                        >
                    </div>
                </article>
            </div>
        </div>
        <!-- <HomeApproach /> -->
        <FeaturedProject project={featuredProject!} />
        <Testimonials />
        <CTA />
    </main>
</Layout>

<style>
    #services {
        position: relative;
        top: -2.6rem;

        & h2 {
            margin-block-end: var(--space-m);
        }

        & .cta-links {
            --cluster-justify: center;
        }
    }

    @container contentWrapper (max-width: 768px) {
        .text-step-4 {
            font-size: var(--step-3);
        }
    }
</style>
